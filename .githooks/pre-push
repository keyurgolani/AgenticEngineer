#!/bin/sh
# Pre-push hook: Run full validation before pushing

echo "🚀 Running pre-push checks..."

# Change to web directory
cd web

# Run linter
echo "📝 Running ESLint..."
npm run lint
if [ $? -ne 0 ]; then
    echo "❌ Linting failed. Please fix the errors before pushing."
    exit 1
fi

# Run tests
echo "🧪 Running tests..."
npm run test
if [ $? -ne 0 ]; then
    echo "❌ Tests failed. Please fix the failing tests before pushing."
    exit 1
fi

# Run build
echo "🏗️  Running build..."
npm run build
if [ $? -ne 0 ]; then
    echo "❌ Build failed. Please fix the build errors before pushing."
    exit 1
fi

echo "✅ All pre-push checks passed!"
exit 0
